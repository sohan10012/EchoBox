# EchoBox API Gateway Endpoint (HTTP API)
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com
VITE_AWS_REGION=ap-south-1

# Owner User Pool (Email-based authentication for room creators)
VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# EchoBox Identity Pool (Username-only authentication for "Manage My Posts" - No Email)
VITE_COGNITO_IDENTITY_USER_POOL_ID=ap-south-1_yyyyyyyyy
VITE_COGNITO_IDENTITY_CLIENT_ID=yyyyyyyyyyyyyyyyyyyyyyyyyy
